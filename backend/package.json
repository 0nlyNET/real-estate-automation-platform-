{
  "name": "real-estate-automation-platform-backend",
  "version": "0.1.0",
  "description": "Multi-tenant real estate agent automation platform backend (NestJS)",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "npx nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "start:dev": "npx nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "seed": "node dist/scripts/seed.js",
    "seed:dev": "ts-node -r tsconfig-paths/register src/scripts/seed.ts",
    "seed:keenan-demo": "ts-node -r tsconfig-paths/register src/scripts/seed-keenan-demo.ts",
    "schema:sql": "ts-node -r tsconfig-paths/register src/scripts/print-schema-sql.ts",
    "schema:check": "node dist/scripts/schema-check.js",
    "migration:run": "node ./node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "migration:show": "node ./node_modules/typeorm/cli.js migration:show -d dist/database/data-source.js",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^16.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.6.0",
    "twilio": "^6.1.0",
    "typeorm": "^0.3.31",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.19.30",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/validator": "^13.15.10",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "jest": "^29.6.1",
    "pg-mem": "^3.0.14",
    "prettier": "^3.0.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  },
  "overrides": {
    "typeorm": {
      "minimatch": "10.2.5",
      "brace-expansion": "5.0.9"
    }
  }
}
