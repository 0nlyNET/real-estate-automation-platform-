PORT=4000
NODE_ENV=development

# Required. Use at least 32 random characters in production.
JWT_SECRET=
PLATFORM_ADMIN_EMAILS=

# Used only by `npm run seed`; never commit a real password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TENANT_NAME=RealtyTechAI Workspace

# Prefer DATABASE_URL in hosted environments.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/real_estate
DB_HOST=localhost
DB_PORT=55432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=real_estate
DATABASE_SSL=false
# Defaults to false on Railway and true elsewhere when SSL is enabled.
# Set explicitly only when your database provider requires an override.
DATABASE_SSL_REJECT_UNAUTHORIZED=

# Local development only. Use migrations in production.
TYPEORM_SYNC=false

FRONTEND_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_INTAKE_SECRET=
GLOBAL_AUTOMATIONS_DISABLED=false

# Base64-encoded 32 random bytes, for example: openssl rand -base64 32
INTEGRATIONS_ENCRYPTION_KEY=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=RealtyTechAI
SALES_INBOX_EMAIL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Exact public URL registered with Twilio, including scheme/path/query.
TWILIO_WEBHOOK_URL=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_TEAMS_MONTH=
STRIPE_PRICE_TEAMS_YEAR=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URL=
