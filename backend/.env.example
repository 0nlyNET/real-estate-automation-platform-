# Runtime and public URLs
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
# Public HTTPS backend URL used by provider webhooks in production.
PUBLIC_API_URL=http://localhost:4000

# Google Calendar OAuth (server-side only). In Google Cloud, enable the
# Calendar API and register this exact redirect URI:
# <PUBLIC_API_URL>/calendar/google/oauth/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Optional override. Defaults to
# <PUBLIC_API_URL>/calendar/google/notifications and must be public HTTPS.
GOOGLE_CALENDAR_WEBHOOK_URL=

# Critical platform security
# Production JWT_SECRET: at least 32 random characters.
JWT_SECRET=
PLATFORM_ADMIN_EMAILS=
# Optional operational staff. Staff cannot access billing, system health, role
# management, activation, or impersonation.
PLATFORM_STAFF_EMAILS=
# Base64-encoded 32 random bytes: openssl rand -base64 32
INTEGRATIONS_ENCRYPTION_KEY=
# Optional independent signing secret; JWT_SECRET is the secure fallback.
UNSUBSCRIBE_TOKEN_SECRET=

# Database and migrations
DATABASE_URL=postgres://postgres:postgres@localhost:55432/real_estate
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=
RUN_MIGRATIONS=true
# Local empty databases only. Production validation requires false.
TYPEORM_SYNC=false
# Individual DB_* values are a local fallback when DATABASE_URL is absent.
DB_HOST=localhost
DB_PORT=55432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=real_estate

# Lifecycle, billing grace, and worker safety
GLOBAL_AUTOMATIONS_DISABLED=false
BILLING_GRACE_DAYS=0
# Message and sequence workers run in-process with database claim leases.
# Critical reconciliation/monitoring schedules are persisted in durable_jobs.

# System email and operations notifications
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=RealtyTechAI
SALES_INBOX_EMAIL=

# Stripe billing: one recurring service plus one setup fee on the first checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SERVICE_MONTH=
STRIPE_PRICE_SETUP_ONCE=
# Existing subscriptions keep working from their stored Stripe subscription
# and price IDs; no legacy price variables are required.
# No Stripe publishable key is used; checkout and portal sessions are server-created.

# Admin web push. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:realtytechai@gmail.com

# Operational webhook/notification/AI retention (30-365 days). Immutable audit events are never purged by this job.
OPERATIONAL_RETENTION_DAYS=90

# Twilio public callbacks
# The platform Twilio parent credential is saved once in Admin. Tenant
# subaccount credentials and resource SIDs are created and encrypted server-side.
TWILIO_WEBHOOK_URL=https://api.example.com/webhooks/twilio/inbound
TWILIO_STATUS_CALLBACK_URL=https://api.example.com/webhooks/twilio/status
TWILIO_DEFAULT_COUNTRY=US
TWILIO_DEFAULT_AREA_CODE=
# One-time Trust Hub setup. The primary profile itself is the unavoidable
# provider/account-owner verification step; tenant profiles/brands/campaigns
# are then submitted and polled automatically.
TWILIO_PRIMARY_CUSTOMER_PROFILE_SID=
TWILIO_SECONDARY_PROFILE_POLICY_SID=
TWILIO_A2P_TRUST_PRODUCT_POLICY_SID=

# SendGrid Inbound Parse (tenant routing address is saved in Integrations).
# These values are also the OAuth client ID and client secret configured in
# the Parse Webhook security policy.
# Token URL: https://api.example.com/webhooks/sendgrid/oauth/token
SENDGRID_INBOUND_WEBHOOK_URL=https://api.example.com/webhooks/sendgrid/inbound
SENDGRID_INBOUND_USERNAME=
SENDGRID_INBOUND_PASSWORD=
SENDGRID_SENDING_DOMAIN=send.example.com
SENDGRID_REPLY_DOMAIN=reply.example.com
SENDGRID_EVENT_WEBHOOK_URL=https://api.example.com/webhooks/sendgrid/events
SENDGRID_SPF_VERIFIED_AT=
SENDGRID_DKIM_VERIFIED_AT=
SENDGRID_DMARC_VERIFIED_AT=

# Additional owner-approved HTTPS hosts for signed outbound CRM webhooks.
# hooks.zapier.com is built in. Do not add private/internal destinations.
OUTBOUND_WEBHOOK_ALLOWED_HOSTS=

# Controlled AI lead assistant. These values are backend-only; never expose
# them through NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Optional separate model for Client AI and Operations AI.
OPENAI_ASSISTANT_MODEL=
AI_MODEL_TIMEOUT_MS=15000
AI_MODEL_MAX_RETRIES=1
AI_MAX_CONTEXT_CHARACTERS=12000
AI_CIRCUIT_BREAKER_FAILURES=5
AI_CIRCUIT_BREAKER_WINDOW_MS=300000
AI_CIRCUIT_BREAKER_COOLDOWN_MS=600000
# Optional rates used only for estimated client cost reporting.
AI_INPUT_COST_PER_MILLION_USD=
AI_OUTPUT_COST_PER_MILLION_USD=

# Launch usage/cost reservations. Database policies are configurable in Admin;
# these values estimate provider cost before a request is submitted.
ESTIMATED_SMS_COST_USD=0.01
ESTIMATED_EMAIL_COST_USD=0.001
ESTIMATED_AI_CALL_COST_USD=0.02
ESTIMATED_LEAD_INGESTION_COST_USD=0

# Disaster-recovery evidence. Populate only after the isolated restore runbook
# passes. Production activation requires a test within the last 90 days.
BACKUP_RESTORE_TESTED_AT=
BACKUP_RPO_MINUTES=
BACKUP_RTO_MINUTES=
BACKUP_RETENTION_DAYS=
BACKUP_RESTORE_ISOLATED_VERIFIED=false
BACKUP_RESTORE_CREDENTIALS_PROTECTED=false

# Date qualified counsel last reviewed the actual customer-facing documents.
LEGAL_DOCUMENTS_REVIEWED_AT=

# External monitoring cannot be replaced by in-process checks. Configure a
# third-party monitor for /health/live and /health/ready and record its URL.
EXTERNAL_UPTIME_MONITOR_URL=

# Client PII is exportable during this window, then automatically anonymized.
# Immutable audit, consent evidence, and billing records remain retained.
CLIENT_DATA_RETENTION_DAYS=30

# Meta Lead Ads (only required when that integration is offered)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URL=https://api.example.com/integrations/facebook/callback
FACEBOOK_GRAPH_API_VERSION=v19.0
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_WEBHOOK_URL=https://api.example.com/webhooks/facebook/lead-ads

# First-owner seed; never commit a real password
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TENANT_NAME=RealtyTechAI Workspace
