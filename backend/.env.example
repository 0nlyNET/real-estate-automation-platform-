# Runtime and public URLs
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
# Public HTTPS backend URL used by provider webhooks in production.
PUBLIC_API_URL=http://localhost:4000

# Critical platform security
# Production JWT_SECRET: at least 32 random characters.
JWT_SECRET=
PLATFORM_ADMIN_EMAILS=
# Optional operational staff. Staff cannot access billing, system health, role
# management, activation, or impersonation.
PLATFORM_STAFF_EMAILS=
# Base64-encoded 32 random bytes: openssl rand -base64 32
INTEGRATIONS_ENCRYPTION_KEY=
# Optional independent signing secret; JWT_SECRET is the secure fallback.
UNSUBSCRIBE_TOKEN_SECRET=

# Database and migrations
DATABASE_URL=postgres://postgres:postgres@localhost:55432/real_estate
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=
RUN_MIGRATIONS=true
# Local empty databases only. Production validation requires false.
TYPEORM_SYNC=false
# Individual DB_* values are a local fallback when DATABASE_URL is absent.
DB_HOST=localhost
DB_PORT=55432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=real_estate

# Lifecycle, billing grace, and worker safety
GLOBAL_AUTOMATIONS_DISABLED=false
BILLING_GRACE_DAYS=0
# Message and sequence workers run in-process with database claim leases.

# System email and operations notifications
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=RealtyTechAI
SALES_INBOX_EMAIL=

# Stripe billing: one recurring service plus one setup fee on the first checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SERVICE_MONTH=
STRIPE_PRICE_SETUP_ONCE=
# Existing subscriptions keep working from their stored Stripe subscription
# and price IDs; no legacy price variables are required.
# No Stripe publishable key is used; checkout and portal sessions are server-created.

# Admin web push. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:realtytechai@gmail.com

# Operational audit/webhook/notification retention (30-365 days).
OPERATIONAL_RETENTION_DAYS=90

# Twilio public callbacks
# Tenant Account SID, auth token, sender, and Messaging Service SID belong in encrypted tenant integration storage.
TWILIO_WEBHOOK_URL=https://api.example.com/webhooks/twilio/inbound
TWILIO_STATUS_CALLBACK_URL=https://api.example.com/webhooks/twilio/status

# SendGrid Inbound Parse (tenant routing address is saved in Integrations).
# These values are also the OAuth client ID and client secret configured in
# the Parse Webhook security policy.
# Token URL: https://api.example.com/webhooks/sendgrid/oauth/token
SENDGRID_INBOUND_WEBHOOK_URL=https://api.example.com/webhooks/sendgrid/inbound
SENDGRID_INBOUND_USERNAME=
SENDGRID_INBOUND_PASSWORD=

# Controlled AI lead assistant. These values are backend-only; never expose
# them through NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
AI_MODEL_TIMEOUT_MS=15000
AI_MODEL_MAX_RETRIES=1
AI_MAX_CONTEXT_CHARACTERS=12000
AI_CIRCUIT_BREAKER_FAILURES=5
AI_CIRCUIT_BREAKER_WINDOW_MS=300000
AI_CIRCUIT_BREAKER_COOLDOWN_MS=600000
# Optional rates used only for estimated client cost reporting.
AI_INPUT_COST_PER_MILLION_USD=
AI_OUTPUT_COST_PER_MILLION_USD=

# Meta Lead Ads (only required when that integration is offered)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URL=https://api.example.com/integrations/facebook/callback
FACEBOOK_GRAPH_API_VERSION=v19.0
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_WEBHOOK_URL=https://api.example.com/webhooks/facebook/lead-ads

# First-owner seed; never commit a real password
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TENANT_NAME=RealtyTechAI Workspace
