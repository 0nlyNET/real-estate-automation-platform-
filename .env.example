# Local Docker Compose configuration only. Production values belong in Railway/Vercel.

# Platform security
JWT_SECRET=replace-with-at-least-32-random-characters
PLATFORM_ADMIN_EMAILS=
PLATFORM_STAFF_EMAILS=
# Base64 of exactly 32 random bytes: openssl rand -base64 32
INTEGRATIONS_ENCRYPTION_KEY=
UNSUBSCRIBE_TOKEN_SECRET=

# Google Calendar OAuth. Register the exact backend callback URI:
# http://localhost:4000/calendar/google/oauth/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Optional production override; otherwise PUBLIC_API_URL is used.
GOOGLE_CALENDAR_WEBHOOK_URL=

# First local owner seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TENANT_NAME=RealtyTechAI Workspace

# Lifecycle policy
GLOBAL_AUTOMATIONS_DISABLED=false
BILLING_GRACE_DAYS=0

# System email and operations
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=RealtyTechAI
SALES_INBOX_EMAIL=

# Stripe test mode; all configured values must be from the same mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SERVICE_MONTH=
STRIPE_PRICE_SETUP_ONCE=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:realtytechai@gmail.com
# Operational webhook/notification/AI retention. Immutable audit events are not purged.
OPERATIONAL_RETENTION_DAYS=90

# Twilio callback URLs; tenant subaccounts and numbers are provisioned by the backend.
TWILIO_WEBHOOK_URL=http://localhost:4000/webhooks/twilio/inbound
TWILIO_STATUS_CALLBACK_URL=http://localhost:4000/webhooks/twilio/status
TWILIO_DEFAULT_COUNTRY=US
TWILIO_DEFAULT_AREA_CODE=
TWILIO_PRIMARY_CUSTOMER_PROFILE_SID=
TWILIO_SECONDARY_PROFILE_POLICY_SID=
TWILIO_A2P_TRUST_PRODUCT_POLICY_SID=

# Tenant inbound email parse. These values are also the OAuth client ID and
# client secret configured in the SendGrid Parse Webhook security policy.
# Token URL: https://api.example.com/webhooks/sendgrid/oauth/token
SENDGRID_INBOUND_WEBHOOK_URL=http://localhost:4000/webhooks/sendgrid/inbound
SENDGRID_INBOUND_USERNAME=
SENDGRID_INBOUND_PASSWORD=
SENDGRID_SENDING_DOMAIN=send.example.test
SENDGRID_REPLY_DOMAIN=reply.example.test

# Controlled AI lead assistant. Workspaces remain human_only until separately
# configured, approved, and enabled by an owner/admin.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
AI_MODEL_TIMEOUT_MS=15000
AI_MODEL_MAX_RETRIES=1
AI_MAX_CONTEXT_CHARACTERS=12000
AI_CIRCUIT_BREAKER_FAILURES=5
AI_CIRCUIT_BREAKER_WINDOW_MS=300000
AI_CIRCUIT_BREAKER_COOLDOWN_MS=600000
AI_INPUT_COST_PER_MILLION_USD=
AI_OUTPUT_COST_PER_MILLION_USD=
ESTIMATED_SMS_COST_USD=0.01
ESTIMATED_EMAIL_COST_USD=0.001
ESTIMATED_AI_CALL_COST_USD=0.02
ESTIMATED_LEAD_INGESTION_COST_USD=0

# Populate only from completed operational evidence; see docs.
BACKUP_RESTORE_TESTED_AT=
BACKUP_RPO_MINUTES=
BACKUP_RTO_MINUTES=
BACKUP_RETENTION_DAYS=
BACKUP_RESTORE_ISOLATED_VERIFIED=false
BACKUP_RESTORE_CREDENTIALS_PROTECTED=false
LEGAL_DOCUMENTS_REVIEWED_AT=
EXTERNAL_UPTIME_MONITOR_URL=
CLIENT_DATA_RETENTION_DAYS=30

# Meta Lead Ads; optional unless included in a pilot
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URL=http://localhost:4000/integrations/facebook/callback
FACEBOOK_GRAPH_API_VERSION=v19.0
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_WEBHOOK_URL=http://localhost:4000/webhooks/facebook/lead-ads
